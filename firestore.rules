rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者チェック用ヘルパー
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isManager() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/managers/$(request.auth.uid));
    }

    match /reservations/{docId} {
      allow read, create: if true;
      allow update: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /board_comments/{docId} {
      allow read, create: if true;
      allow delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /renban_events/{docId} {
      allow read, create: if true;
      // イベント編集・期限切れ設定（manualExpired）で本人/管理者がupdateを使う
      allow update: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
      match /participants/{partId} {
        allow read, create: if true;
        allow update, delete: if request.auth != null &&
          (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /rsv_participants/{docId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /jare_stories/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /managers/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /stamp_cards/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /swarm_accounts/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /swarm_accounts_admin/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /admin_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_gathers/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ai_discussions/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /walk_logs/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /vote_boxes/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin() || isManager());
    }

    match /vote_answers/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /columns/{docId} {
      allow read: if resource.data.status == 'published' ||
        (request.auth != null && request.auth.uid == resource.data.authorUid) ||
        isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // 弐寺☆12ランプ表の曲表（管理者・マネージャーが更新可）
    match /iidx_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isManager();
    }

    // 弐寺☆12ランプ（本人のみ書き込み可。ページ自体が管理者・マネージャー用）
    match /iidx_lamps/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId &&
        (isAdmin() || isManager());
    }

    // APIキーなどのシークレット（書き込みは管理者のみ。読み取りはマネージャーも可
    // ──弐寺ランプ表のリザルト読み取りでGeminiキーを使うため）
    match /admin_secrets/{docId} {
      allow read: if isAdmin() || isManager();
      allow write: if isAdmin();
    }

    match /fcm_tokens/{token} {
      // 通知トークン: 登録・解除は誰でも可（トークン自体が推測不能な秘密）。読み取りは不可
      allow read: if false;
      allow create, update, delete: if true;
    }
  }
}
